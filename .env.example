# Cloudflare 시험용 (협업안 ⑤). 실제 값은 .env에만 — Git 제외
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# RAG API (scripts/build_rag_index.py, api/app.py) — 비우면 기본값
RAG_CORPUS=data/rag/corpus_all.json
RAG_INDEX_DIR=index/rag
RAG_BGE_MODEL=BAAI/bge-m3
RAG_QWEN_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_TOP_K=50
RAG_TOP_N=5
RAG_RRF_K=60
RAG_KO_RATIO=0.3
RAG_WEIGHTS_KO=bge=1,qwen=1,bm25=0
# 한국어 질문에 한↔영 용어 사전의 영어 용어를 덧붙여 검색 (0이면 끔)
RAG_EXPAND_KO=1
RAG_WEIGHTS_EN=bge=1,qwen=1,bm25=1
RAG_WARMUP=0
